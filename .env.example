# Copy these into Vercel (Project Settings, Environment Variables). Never commit real values.

# Required for the support form (/api/contact). Create a key at https://resend.com
RESEND_API_KEY=

# Sender shown on the notification email. The domain must be verified in Resend.
CONTACT_FROM="Mirel support <support@aurelletheme.com>"

# Optional. Defaults to the support address in src/config/site.ts.
# CONTACT_TO=support@aurelletheme.com
